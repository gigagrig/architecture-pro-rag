@startuml
left to right direction
skinparam componentStyle rectangle
folder "knowledge_base/\nentity_*.md" as source
file "fixtures/prompt_injection.txt\nextra document from task 5" as extra
node "Docker Compose" {
  component "index-updater\nstartup + daily 03:00 UTC\nretry after error: 300 s" as scheduler
  component "update_index.py\nSHA-256 + file lock" as updater
  component "Chunks\n100–250 words, overlap 40" as chunks
  component "multilingual-e5-base\nnew/changed passages only" as embeddings
  database "FAISS snapshots\nvector_index/revisions/" as index
  component "API Retriever\nreload before search" as api
  artifact "Docker stdout logs\njson-file: 3 x 10 MB" as logs
}
file "vector_index/current\natomic symlink replacement" as pointer
scheduler --> updater : run
source --> updater : scan
extra --> updater : scan
updater --> chunks
chunks --> embeddings
embeddings --> index : normalized vectors
index --> updater : reuse unchanged vectors
updater --> pointer : publish complete snapshot
pointer --> api : resolve one revision
index --> api : index + metadata
updater --> logs : start, finish, counts, errors
@enduml
